# Número de WhatsApp del salón en formato internacional, sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=5492610000000
# Teléfonos que se muestran en el sitio, separados por coma.
NEXT_PUBLIC_SALON_PHONES=261 000 0000,261 000 0001

# Panel del salón (/panel)
PANEL_PASSWORD=cambiar-esta-contraseña
# Clave para firmar la sesión, mínimo 32 caracteres. Generala con: openssl rand -base64 32
PANEL_SESSION_SECRET=

# Base de datos Postgres (Neon). En Vercel la carga sola la integración de Neon.
# Sin ella, las consultas se guardan en .data/party-requests.json (solo desarrollo).
DATABASE_URL=

# Google Calendar (opcional). Si falta alguna, se usa la agenda simulada.
# Compartí el calendario del salón con el email de la cuenta de servicio (permiso de lectura).
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
